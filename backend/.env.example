# Application
NODE_ENV=development
PORT=4000
APP_NAME=Elevate Workforce

# Frontend (used for CORS and password-reset links)
FRONTEND_URL=http://localhost:3001

# PostgreSQL
DATABASE_URL="postgresql://dev:dev@localhost:5432/myjobportal?schema=public"

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_COOKIE_NAME=access_token

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CSRF (set true when using a browser frontend with cookie auth)
CSRF_ENABLED=false
CSRF_COOKIE_NAME=csrf_token

# Password hashing
BCRYPT_SALT_ROUNDS=10

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=5
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100

# Redis cache
JOB_LIST_CACHE_TTL_SECONDS=60

# Uploads
UPLOAD_DIR=uploads
MAX_RESUME_SIZE_MB=5
MAX_IMAGE_SIZE_MB=2

# Seq
SEQ_URL=http://localhost:5341
SEQ_API_KEY=

# SMTP - smtp4dev
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Elevate Workforce <noreply@elevateworkforce.local>"

# Password reset
PASSWORD_RESET_TTL_SECONDS=900
